# Discord Light: Discord's light look. RustCord has the same look built in
# as "Discord Light" (Settings -> Themes); this file stays as an example to
# copy and edit.
format = 1

[meta]
name = "Discord Light"
author = "RustCord"
version = "1.0"
description = "Discord's light look."
base = "light"

[colors]
servers = "#e3e5e8"
sidebar = "#f2f3f5"
chat = "#ffffff"
input = "#ebedef"
hover = "#e0e1e5"
selected = "#d4d7dc"
text = "#313338"
muted = "#5c5e66"
accent = "#5865f2"
online = "#23a55a"
idle = "#f0b232"
dnd = "#f23f43"
offline = "#80848e"
danger = "#da373c"
mention = "#f23f43"
unread = "#060607"
strong = "#060607"
msg_hover = "#f7f7f8"
divider = "#e1e2e4"
rail_icon = "#ffffff"

[style]
# The classic look: flat panes without borders, gaps or labels, Noto Sans.
corner_scale = 1.0
font_family = "sans"
shape = "round"
avatar_shape = "round"
frame = { enabled = false }
